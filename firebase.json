{
  "hosting": {
    "public": "the_collector/build/web",
    "predeploy": [
      "cd the_collector && flutter build web --release"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 18080,
      "websocketPort": 19150
    },
    "auth": {
      "host": "127.0.0.1",
      "port": 19099
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 19199
    },
    "ui": {
      "enabled": false
    },
    "hub": {
      "host": "127.0.0.1",
      "port": 14400
    },
    "logging": {
      "host": "127.0.0.1",
      "port": 14500
    },
    "singleProjectMode": false,
    "functions": {
      "host": "127.0.0.1",
      "port": 15001
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "collector",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "lib/test",
        "*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
